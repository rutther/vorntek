# No secrets here. Generate per-installation secrets with scripts/configure.py.
COMPOSE_PROJECT_NAME=vorntek
NEWCROWN_HTTP_PORT=8088
NEWCROWN_SITE_URL=http://localhost:8088
NEWCROWN_ARTICLE_PUBLIC_ORIGIN=https://vorntek.example
NEWCROWN_ALLOWED_HOSTS=localhost,127.0.0.1,crm
# Exact append-only proxy peer IPs/CIDRs after verifying this installation.
# Empty trusts only the socket peer; never use a global/default-route range.
NEWCROWN_TRUSTED_PROXY_CIDRS=
NEWCROWN_CRM_IMAGE=vorntek-crm:dev
NEWCROWN_WEBSITE_IMAGE=vorntek-website:dev
NEWCROWN_MAINTENANCE_IMAGE=vorntek-maintenance:dev
