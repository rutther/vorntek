ARG NGINX_IMAGE=nginx:1.28.0-alpine
FROM ${NGINX_IMAGE}
COPY apps/website/ /srv/website/releases/bundled/
RUN printf '%s\n' '{"kind":"websiteServingStore","schemaVersion":1}' > /srv/website/owner.json \
    && ln -s releases/bundled /srv/website/current
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
