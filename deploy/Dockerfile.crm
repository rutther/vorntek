ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm
ARG NODE_IMAGE=node:24.20.0-bookworm-slim
FROM ${NODE_IMAGE} AS flow-builder
WORKDIR /build/apps/crm/flow-ui
COPY apps/crm/flow-ui/package.json apps/crm/flow-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/crm/flow-ui/ ./
COPY apps/crm/console/static/ ../console/static/
COPY apps/website/assets/meta-pixel.js /build/apps/website/assets/meta-pixel.js
COPY scripts/test_website_pixel_runtime.mjs /build/scripts/test_website_pixel_runtime.mjs
RUN node --test /build/scripts/test_website_pixel_runtime.mjs && npm test && npm run build

FROM ${PYTHON_IMAGE} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY apps/crm/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock \
    && groupadd --gid 10001 newcrown \
    && useradd --uid 10001 --gid 10001 --no-create-home newcrown
COPY apps/crm/ /app/
COPY --from=flow-builder /build/apps/crm/console/static/console/flow-workspace/ /app/console/static/console/flow-workspace/
COPY --from=flow-builder /build/apps/crm/console/static/console/meta-help/ /app/console/static/console/meta-help/
COPY apps/website/ /app/website-source/
COPY apps/website/ /srv/website/releases/bundled/
COPY VERSION /app/VERSION
RUN mkdir -p /app/staticfiles /app/.runtime/customer-exports /data/assets /data/crm-attachments /data/whatsapp-media \
    && printf '%s\n' '{"kind":"websiteServingStore","schemaVersion":1}' > /srv/website/owner.json \
    && ln -s releases/bundled /srv/website/current \
    && chown -R 10001:10001 /app/staticfiles /app/.runtime /data /srv/website \
    && chown -h 10001:10001 /srv/website/current
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "siteos_admin.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "60", "--access-logfile", "-", "--access-logformat", "%(t)s \"%(m)s %(U)s %(H)s\" %(s)s %(b)s", "--error-logfile", "-"]
